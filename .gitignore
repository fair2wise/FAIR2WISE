# Don't push research papers to the repo to avoid any licensing issues.
# Beamline ops documents are allowed (owner decision 2026-10-12): re-include them below.
papers/**
!papers/**/
!papers/rsoxs/beamline_blueprint/blueprint_*.html

logs/

# Local process pid files (outside logs/)
.run/
*.pid

# All KGs in storage/kg are committed (owner decision 2026-10-12). Terminology harvest JSON is
# tracked and shipped in every image too (owner decision PC-1 / D3.1, O-D3, 2026-10-30).
storage/terminology/*.json.bak

# Hybrid source-RAG indexes (rebuild with scripts/index_source_rag.py)
storage/source_index/

# Playwright
ui/test-results/
ui/playwright-report/
ui/blob-report/
ui/playwright/.cache/

# FORGE donor source and local migration scratch (plan/specs live in docs/migration/)
AGENT/

# T11B pilot labels: private paper quotes and parsed text (H3 B4); default dir is outside the repo
.pilot_labels/

# graphify output (local analysis only; already excluded from the image build context)
graphify-out/
**/graphify-out/

# pixi environments (created by `pixi install`; see pixi.toml / pixi.lock)
.pixi/
