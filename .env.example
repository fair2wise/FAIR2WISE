# FAIR2WISE environment file. Copy to a private file (for example .env or f2w.env); never commit a filled copy.
#
# Format rules (so the same file works for `docker run --env-file`, compose `env_file:` and the launchers):
#   - KEY=VALUE, one per line, no quotes, no `export`.
#   - Comments are on their own lines. Never put a `# comment` after a value: `docker run --env-file`
#     keeps it as part of the value.
#   - Lines that start with `# NAME=` are optional settings that are off by default.
#   - Settings marked SECRET are credentials: leave them empty here, fill them only in your private copy.
#
# Which loader reads what:
#   - The launchers under scripts/ and the checkout load a `.env` file (see app/modules/dotenv_entry.py).
#   - The :local image sets F2W_DOTENV=off and reads only the real process environment
#     (`docker run --env-file`, compose `env_file:`); scripts/run_local_container.sh reads only CBORG_API_KEY
#     from the dotenv file.
#   - Profile values fill only BLANK names, so a value set here wins over the image profile.

# ---- CBORG (LLM gateway)
# CBORG authorizes by source address: see mkdocs/docs/standalone-install.md before the first call.
# SECRET: the CBORG key.
CBORG_API_KEY=
CBORG_BASE_URL=https://api.cborg.lbl.gov
# Most CBORG calls in flight at once (default 5).
# CBORG_MAX_CONCURRENCY=5
# Pin the CBORG source address to IPv6. Only for a host whose global IPv6 address CBORG has authorized.
# A pinned client uses an explicit transport and does not use HTTP(S)_PROXY.
# CBORG_IP_FAMILY=ipv6
# CBORG_FORCE_IPV6=1
# Leave CBORG_IPV6_BIND unset: a currently assigned global IPv6 address is probed at start, and a stale
# value fails with "Can't assign requested address".
# CBORG_IPV6_BIND=

# ---- Literature sources
# Contact address for the OpenAlex polite pool and Unpaywall.
# OPENALEX_EMAIL=
# SECRET, process-only: OPENALEX_API_KEY is never read from a dotenv file (owner decision 2026-11-09).
# It must be exported in the process environment: `docker run --env-file`, compose `env_file:`, or `export`.
# Setting it in a .env file has no effect.
# OPENALEX_API_KEY=
# SECRET: CORE.ac.uk open-access PDF lookup (sent as an Authorization header).
# CORE_API_KEY=
# SECRET: Materials Project lookup.
# MP_API_KEY=
# SECRET: GitHub token for source-code snippets from paper-linked repositories.
# GITHUB_TOKEN=

# ---- Local models (optional)
# Base URL of an Ollama server. No default: extraction and the model list use it only when set.
# OLLAMA_URL=
# Extraction backend, for example ollama.
# F2W_EXTRACT_BACKEND=
# Hosts that must not go through an egress proxy (the Ollama host, internal names), comma separated.
# The app does not add the Ollama host for you.
# NO_PROXY=
# HTTP_PROXY=
# HTTPS_PROXY=
# Set to 1 only when third-party PDF downloads must pass through the proxy above: the proxy's own address
# is then allowed as the peer. Affects PDF fetches only (not CBORG, Ollama or OpenAlex).
# F2W_SAFE_FETCH_TRUST_PROXY=1

# ---- Storage (container paths in the image; the image profile sets defaults)
# F2W_LIBRARY_DIR=/var/lib/fair2wise/library
# Browsable paper folders, label=/absolute/path entries (local profile only).
# F2W_FOLDER_ROOTS=
# F2W_KG_RELEASE_DIR=/var/lib/fair2wise/state/kg_releases

# ---- Knowledge-graph chat
# Do not set KG_RAG_GRAPH_SOURCE=splash unless a splash_links server is running (legacy editable mode).
KG_RAG_GRAPH_SOURCE=json
KG_RAG_BACKEND=cborg
KG_RAG_CBORG_MODEL=lbl/cborg-chat
KG_RAG_RETRIEVAL_BACKEND=lexical
KG_RAG_LLM_TIMEOUT=180
KG_RAG_CTX_CHARS=32000
KG_RAG_SHOW_BASELINE=0
# Graph files for the scripts launchers, comma separated.
# F2W_GRAPH=storage/kg/matkg_rsoxs_v1.json
# Legacy Splash mode only:
# KG_RAG_SPLASH_URI=splash://localhost:8081
# SPLASH_LINKS_REPO=splash_links
# SPLASH_LINKS_DB=links.sqlite

# ---- Launchers (read by the shell launchers under scripts/, not by the app)
# Product UI and agent ports for start_rsoxs_stack.sh and the compose launchers. Never use 5174 (SSH).
F2W_UI_PORT=5175
F2W_AGENT_PORT=8090
F2W_WORKERS=8

# ---- Disclosure (off by default)
# Set to 1 to show bounded verbatim supporting passages on the node card. Single-operator deployments only;
# leave it off on any multi-user or shared deployment (docs/adr/content-disclosure.md, section 4.1).
# F2W_DISCLOSE_SNIPPETS=1

# ---- Metrics and tracing (off by default)
# Metrics need both the flag and an OTLP endpoint.
# F2W_METRICS_ENABLED=1
# F2W_OTEL_ENABLED=1
# OTLP collector endpoint (URL of your collector).
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ---- Optional HPC extraction (Academy / Globus Compute)
# GLOBUS_COMPUTE_ENDPOINT_ID=
