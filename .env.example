# CBORG credentials
CBORG_API_KEY=your-cborg-key-here
CBORG_BASE_URL=https://api.cborg.lbl.gov
CBORG_IP_FAMILY=ipv6
CBORG_FORCE_IPV6=1
# Leave CBORG_IPV6_BIND unset. The process probes a currently assigned global
# IPv6 at start. A stale bind fails with "Can't assign requested address".
# CBORG_IPV6_BIND=

# Product UI (docker compose / start_rsoxs_stack.sh). Never use 5174 (SSH).
# 5173 is also CORS-allowed if that port is free.
F2W_UI_PORT=5175
F2W_AGENT_PORT=8090


# OpenAlex polite pool + Unpaywall PDF lookup
OPENALEX_EMAIL=you@example.com

# Optional CORE.ac.uk OA PDF lookup (Authorization header; never commit a real key)
CORE_API_KEY=

# Optional Materials Project lookup
MP_API_KEY=your-materials-project-key-here

# Optional GitHub API token for source-code snippet extraction from paper-linked repos
GITHUB_TOKEN=

# KG-RAG chat defaults
KG_RAG_BACKEND=cborg
KG_RAG_CBORG_MODEL=lbl/cborg-chat
KG_RAG_GRAPH_SOURCE=splash
KG_RAG_SPLASH_URI=splash://localhost:8081
SPLASH_LINKS_REPO=splash_links
SPLASH_LINKS_DB=links.sqlite
KG_RAG_SPLASH_PAGE_SIZE=1000
KG_RAG_GRAPH=storage/kg/matkg_with_code.json
# To query the RSoXS JSON demo instead of splash_links:
# KG_RAG_GRAPH_SOURCE=json
# KG_RAG_GRAPH=storage/kg/matkg_rsoxs_v1.json
KG_RAG_RETRIEVAL_BACKEND=lexical
KG_RAG_LLM_TIMEOUT=180
KG_RAG_CTX_CHARS=32000
KG_RAG_SHOW_BASELINE=0
F2W_WORKERS=8

# Repo-local PyStow cache avoids user-specific paths and permission issues.
PYSTOW_HOME=.cache/pystow

# Academy / Globus Compute (HPC remote extraction)
GLOBUS_COMPUTE_ENDPOINT_ID=
GLOBUS_PROJECT_ID=
ACADEMY_GLOBUS_CLIENT_ID=
ACADEMY_GLOBUS_CLIENT_SECRET=
