{
  "id": "graph_node_patch_unlink_and_remove",
  "flow": "splash_app",
  "kg_mode": "splash",
  "notes": "unlink + relationship remove; snippets omitted from the list are also unlinked (api.py:3331-3332)",
  "request": {
    "method": "PATCH",
    "path": "/graph/node/matkg:TermA",
    "json": {
      "linked_code_snippets": [
        {
          "id": "matkg:Code1",
          "_action": "unlink"
        }
      ],
      "relationship_updates": [
        {
          "action": "remove",
          "source": "matkg:Other",
          "predicate": "rel:affects",
          "target": "matkg:TermA"
        }
      ]
    }
  },
  "response": {
    "status_code": 200,
    "content_type": "application/json",
    "json": {
      "id": "matkg:TermA",
      "label": "Term A edited",
      "type": "Technique",
      "description": "edited description",
      "publications": [
        {
          "source_paper": "edited.pdf",
          "publication_year": 2025,
          "paper_title": "Edited Paper",
          "doi": "10.0000/contract.edit"
        },
        {
          "source_paper": "edited.pdf"
        }
      ],
      "code_snippet": null,
      "code_language": null,
      "function_name": null,
      "linked_code_snippets": [],
      "graph_id": "kg",
      "graph_label": "kg",
      "formula": null,
      "source_papers": [
        "edited.pdf"
      ],
      "properties": [],
      "extra_fields": {},
      "source_type": null,
      "repo_url": null,
      "repo_owner": null,
      "repo_name": null,
      "repo_commit_sha": null,
      "source_file_path": null,
      "source_file_url": null,
      "source_start_line": null,
      "source_end_line": null,
      "repository_license": null
    }
  }
}
